---
layout: layouts/base.liquid
---

  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title">{% for line in hero.headline %}{% unless forloop.first %}
        <br>{% endunless %}{{ line | md }}{% endfor %}</h1>
      <div class="hero-thesis">
        <p class="hero-thesis-lead">{{ hero.lead | md }}</p>
        <ul>
{%- for ex in hero.examples %}
          <li>{{ ex | md }}</li>
{%- endfor %}
        </ul>
        <p>{{ hero.closing | md }}</p>
      </div>
      <p class="hero-more"><a href="approach.html">{{ hero.more_link | md }}</a></p>
    </div>
  </section>
  <section class="cards-section" aria-labelledby="cs-heading">
    <div class="wrap">
      <h2 class="section-label" id="case-studies"><span id="cs-heading">Case studies</span></h2>
      <div class="cards-grid">
{% for cs in collections.caseStudies %}
        <a class="case-card" href="{{ cs.url | rel }}">
          <div class="card-num">Case study {{ cs.data.num }}</div>
          <div class="card-title">{{ cs.data.title | md }}</div>
          <div class="card-problem">{{ cs.data.summary | md }}</div>
          <div class="card-tags">{% for tag in cs.data.tags %}<span class="tag">{{ tag | md }}</span>{% endfor %}</div>
          <div class="card-cta">View case study →</div>
        </a>
{% endfor %}
      </div>
    </div>
  </section>

