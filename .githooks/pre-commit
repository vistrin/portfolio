#!/bin/sh
# Block commits when the site fails to build or contains banned career content.
# Enabled with: git config core.hooksPath .githooks
# Builds into .lint-build/ so lint-site also sees the generated pages (Experience text, SVG diagrams).
OUT=.lint-build
rm -rf "$OUT"
npx --no-install @11ty/eleventy --quiet --output="$OUT" >/dev/null || { echo "pre-commit: site build failed" >&2; rm -rf "$OUT"; exit 1; }
status=0
if [ -f ../career-db/tools/career_db.py ]; then
  PYTHONIOENCODING=utf-8 python ../career-db/tools/career_db.py lint-site . || status=1
else
  echo "pre-commit: ../career-db not found; skipping lint-site" >&2
fi
rm -rf "$OUT"
exit $status
