#!/bin/sh
# Block commits when generated page sections are stale or the site contains banned career content.
# Enabled with: git config core.hooksPath .githooks
python build.py --check || exit 1
if [ -f ../career-db/tools/career_db.py ]; then
  PYTHONIOENCODING=utf-8 python ../career-db/tools/career_db.py lint-site . || exit 1
else
  echo "pre-commit: ../career-db not found; skipping lint-site" >&2
fi
